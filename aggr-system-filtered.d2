    L4: {shape: cloud; class: ext; label: "Внешний сервис"}
    L5: {shape: person; class: client; label: "Клиент"}
    L6: {label: "Сервер приложений"}
  }
  "Связи": {
    direction: right
    E0: {class: hide}
    E1: {class: hide}
    E2: {class: hide}
    E3: {class: hide}
    E4: {class: hide}
    E0 -> E1: "порт TCP · приложение" {class: app; style.font-size: 32}
    E1 -> E2: "445 TCP · служебный" {class: essential; style.font-size: 32}
    E2 -> E3: "1433 TCP · к СУБД" {class: db; style.font-size: 32}
    E3 -> E4: "443 · защищённый канал" {class: tunnel; style.font-size: 32}
  }
  "Периметр": {
    direction: right
    P1: {label: "Intranet — внутри периметра банка"; style.fill: "#ddf4ff"; style.stroke: "#0969da"}
    P2: {label: "Extranet — вне периметра"; style.fill: "#ffeef0"; style.stroke: "#cf222e"}
  }
}
